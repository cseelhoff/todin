+package games.strategy.triplea.ai.pro.util;
+
+import games.strategy.engine.data.Territory;
+import games.strategy.triplea.ai.pro.data.ProTerritory;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Debug-only checkpoint hashes for narrowing down divergence inside ProNonCombatMoveAi.
+ * Emits one line per checkpoint to stdout. Diff against the Odin equivalent to localize.
+ *
+ * <p>Gated by -Dpro.ncm.trace=true. Off by default.
+ */
+public final class ProNcmTrace {
+  private ProNcmTrace() {}
+
+  public static final boolean ENABLED =
+      Boolean.parseBoolean(System.getProperty("pro.ncm.trace", "false"));
+
+  /**
+   * Hash a Map&lt;Territory, ProTerritory&gt; by sorted territory name with rich content.
+   * Format per row: "name|U=x|C=y|M=z|V=v|H=h|".
+   */
+  public static void emit(final String label, final Map<Territory, ProTerritory> moveMap) {
+    if (!ENABLED) return;
+    final List<String> names = new ArrayList<>();
+    for (final Territory t : moveMap.keySet()) names.add(t.getName());
+    Collections.sort(names);
+    final StringBuilder sb = new StringBuilder();
+    for (final String n : names) {
+      Territory t = null;
+      for (final Territory tt : moveMap.keySet()) {
+        if (tt.getName().equals(n)) {
+          t = tt;
+          break;
+        }
+      }
+      final ProTerritory pt = moveMap.get(t);
+      sb.append(n).append("|U=").append(pt.getUnits().size()).append("|C=")
+          .append(pt.getCantMoveUnits().size()).append("|M=")
+          .append(pt.getMaxEnemyUnits().size()).append("|V=")
+          .append((long) (pt.getValue() * 1000.0)).append("|H=")
+          .append(pt.isCanHold() ? 1 : 0).append("|");
+      if (Boolean.parseBoolean(System.getProperty("pro.ncm.trace.dump", "false"))) {
+        System.out.printf(
+            "NCM_DUMP label=%s t=%s U=%d C=%d M=%d V=%d H=%d%n",
+            label, n, pt.getUnits().size(), pt.getCantMoveUnits().size(),
+            pt.getMaxEnemyUnits().size(), (long) (pt.getValue() * 1000.0),
+            pt.isCanHold() ? 1 : 0);
+      }
+    }
+    System.out.printf(
+        "NCM_TRACE label=%s h=%016x n=%d%n",
+        label, fnv1a64(sb.toString()), names.size());
+    if (Boolean.parseBoolean(System.getProperty("pro.ncm.trace.dump", "false"))) {
+      for (final String n : names) System.out.println("NCM_DUMP label=" + label + " t=" + n);
+    }
+  }
+  public static void emitList(final String label, final List<ProTerritory> list) {
+    if (!ENABLED) return;
+    final StringBuilder sb = new StringBuilder();
+    int i = 0;
+    for (final ProTerritory pt : list) {
+      sb.append(i++).append('=').append(pt.getTerritory().getName())
+          .append("|V=").append((long) (pt.getValue() * 1000.0))
+          .append("|U=").append(pt.getUnits().size()).append("|");
+    }
+    System.out.printf(
+        "NCM_TRACE label=%s h=%016x n=%d%n",
+        label, fnv1a64(sb.toString()), list.size());
+    if (Boolean.parseBoolean(System.getProperty("pro.ncm.trace.dump", "false"))) {
+      int j = 0;
+      for (final ProTerritory pt : list) {
+        System.out.printf("NCM_DUMP label=%s i=%d t=%s V=%d U=%d%n",
+            label, j++, pt.getTerritory().getName(),
+            (long)(pt.getValue() * 1000.0), pt.getUnits().size());
+      }
+    }
+  }
+
+  private static long fnv1a64(final String s) {
+    long h = 0xcbf29ce484222325L;
+    for (int i = 0; i < s.length(); i++) {
+      h ^= (s.charAt(i) & 0xff);
+      h *= 0x100000001b3L;
+    }
+    return h;
+  }
+  /** Raw key-set hash (just territory names) — for moveMap before ProTerritory fields are populated. */
+  public static void emitRaw(final String label, final Map<Territory, ProTerritory> moveMap) {
+    if (!ENABLED) return;
+    final List<String> names = new ArrayList<>();
+    for (final Territory t : moveMap.keySet()) names.add(t.getName());
+    Collections.sort(names);
+    final StringBuilder sb = new StringBuilder();
+    for (final String n : names) sb.append(n).append('|');
+    System.out.printf(
+        "NCM_TRACE label=%s h=%016x n=%d%n",
+        label, fnv1a64(sb.toString()), names.size());
+    if (Boolean.parseBoolean(System.getProperty("pro.ncm.trace.dump", "false"))) {
+      for (final String n : names) System.out.println("NCM_DUMP label=" + label + " t=" + n);
+    }
+  }
+}
