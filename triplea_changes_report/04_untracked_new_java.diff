+package games.strategy.triplea.ai.pro.util;
+
+import games.strategy.engine.data.GamePlayer;
+import games.strategy.engine.data.Territory;
+import games.strategy.engine.data.Unit;
+import games.strategy.engine.data.UnitType;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Helpers that wrap map iteration in a sort order both the Java
+ * oracle AND the Odin port can reproduce identically.
+ *
+ * <p>Why: stock TripleA relies on {@code LinkedHashMap} insertion
+ * order (which is a function of JVM-hash bucket math). The Odin
+ * port hashes raw pointer values, which are non-deterministic
+ * across processes. Rather than emulate JVM hashCode + bucket
+ * math in Odin, we change BOTH sides to iterate in a sort order
+ * driven by stable, content-addressable keys (territory name,
+ * unit UUID, etc.).
+ *
+ * <p>Use these helpers at every map-iteration site whose order
+ * affects AI decisions. See {@code deterministic-maps.md} for
+ * the running site tracker and policy.
+ */
+public final class ProDeterminism {
+
+  private ProDeterminism() {}
+
+  public static <V> List<Map.Entry<Territory, V>> sortedTerritoryEntries(
+      final Map<Territory, V> m) {
+    final List<Map.Entry<Territory, V>> out = new ArrayList<>(m.entrySet());
+    out.sort(Comparator.comparing(e -> e.getKey().getName()));
+    return out;
+  }
+
+  public static List<Territory> sortedTerritoryKeys(final Map<Territory, ?> m) {
+    final List<Territory> out = new ArrayList<>(m.keySet());
+    out.sort(Comparator.comparing(Territory::getName));
+    return out;
+  }
+
+  public static List<Territory> sortedTerritories(final Iterable<Territory> ts) {
+    final List<Territory> out = new ArrayList<>();
+    for (final Territory t : ts) {
+      out.add(t);
+    }
+    out.sort(Comparator.comparing(Territory::getName));
+    return out;
+  }
+
+  /**
+   * Sort key for units: (unit-type name, alreadyMoved). UUID is
+   * deliberately NOT used — opaque keys are hostile to debugging.
+   * Property collisions are broken by the underlying {@link
+   * java.util.List#sort} stable-sort guarantee, which preserves the
+   * input collection's iteration order. If a future divergence shows
+   * that's insufficient, add a territory-name tiebreak using an
+   * overload that takes a {@code Map<Unit, Territory>}.
+   *
+   * <p>2026-05-12: Added UUID as a final tie-break. Without it,
+   * snap-test reproducibility fails when multiple interchangeable
+   * units (e.g. 4 Russian infantry at Karelia, all with same type
+   * and {@code alreadyMoved=0}) tie on every property — Java's
+   * stable sort then preserves LinkedHashMap insertion order, which
+   * Odin can't reproduce. UUID is content-addressable and
+   * deterministic across both runtimes (it's serialized into the
+   * snap file). Yes, it's opaque in logs, but reproducibility
+   * trumps debug aesthetics for end-of-step state comparison.
+   */
+  private static final Comparator<Unit> UNIT_PROPERTY_ORDER =
+      Comparator.comparing((Unit u) -> u.getType().getName())
+          .thenComparing(Unit::getAlreadyMoved)
+          .thenComparing(u -> u.getId().toString());
+
+  public static <V> List<Map.Entry<Unit, V>> sortedUnitEntries(final Map<Unit, V> m) {
+    final List<Map.Entry<Unit, V>> out = new ArrayList<>(m.entrySet());
+    out.sort(Comparator.comparing(Map.Entry::getKey, UNIT_PROPERTY_ORDER));
+    return out;
+  }
+
+  public static List<Unit> sortedUnitKeys(final Map<Unit, ?> m) {
+    final List<Unit> out = new ArrayList<>(m.keySet());
+    out.sort(UNIT_PROPERTY_ORDER);
+    return out;
+  }
+
+  public static List<Unit> sortedUnits(final Iterable<Unit> us) {
+    final List<Unit> out = new ArrayList<>();
+    for (final Unit u : us) {
+      out.add(u);
+    }
+    out.sort(UNIT_PROPERTY_ORDER);
+    return out;
+  }
+
+  public static <V> List<Map.Entry<GamePlayer, V>> sortedPlayerEntries(
+      final Map<GamePlayer, V> m) {
+    final List<Map.Entry<GamePlayer, V>> out = new ArrayList<>(m.entrySet());
+    out.sort(Comparator.comparing(e -> e.getKey().getName()));
+    return out;
+  }
+
+  public static <V> List<Map.Entry<UnitType, V>> sortedUnitTypeEntries(
+      final Map<UnitType, V> m) {
+    final List<Map.Entry<UnitType, V>> out = new ArrayList<>(m.entrySet());
+    out.sort(Comparator.comparing(e -> e.getKey().getName()));
+    return out;
+  }
+}
