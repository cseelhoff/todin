+package games.strategy.triplea.ai.pro.util;
+
+import games.strategy.engine.data.Territory;
+import games.strategy.engine.data.Unit;
+import games.strategy.triplea.ai.pro.data.ProPlaceTerritory;
+import games.strategy.triplea.ai.pro.data.ProPurchaseTerritory;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Map;
+
+/** Debug-only checkpoint hashes for narrowing divergence inside ProPurchaseAi. */
+public final class ProPurTrace {
+  private ProPurTrace() {}
+
+  public static final boolean ENABLED =
+      Boolean.parseBoolean(System.getProperty("pro.pur.trace", "false"));
+  public static final boolean DUMP =
+      Boolean.parseBoolean(System.getProperty("pro.pur.trace.dump", "false"));
+
+  public static void emit(
+      final String label, final Map<Territory, ProPurchaseTerritory> purchaseTerritories) {
+    if (!ENABLED) return;
+    final List<String> rows = new ArrayList<>();
+    for (final ProPurchaseTerritory ppt : purchaseTerritories.values()) {
+      for (final ProPlaceTerritory placeTerritory : ppt.getCanPlaceTerritories()) {
+        final Territory t = placeTerritory.getTerritory();
+        final List<Unit> units = placeTerritory.getPlaceUnits();
+        final List<String> utNames = new ArrayList<>();
+        for (final Unit u : units) utNames.add(u.getType().getName());
+        Collections.sort(utNames);
+        final StringBuilder sb = new StringBuilder();
+        sb.append(t.getName()).append("|N=").append(units.size()).append("|");
+        for (final String n : utNames) sb.append(n).append(',');
+        rows.add(sb.toString());
+      }
+    }
+    Collections.sort(rows);
+    final StringBuilder full = new StringBuilder();
+    for (final String r : rows) full.append(r).append('|');
+    System.out.printf(
+        "PUR_TRACE label=%s h=%016x n=%d%n", label, fnv1a64(full.toString()), rows.size());
+    if (DUMP) {
+      for (final String r : rows) System.out.println("PUR_DUMP label=" + label + " row=" + r);
+    }
+  }
+
+  private static long fnv1a64(final String s) {
+    long h = 0xcbf29ce484222325L;
+    for (int i = 0; i < s.length(); i++) {
+      h ^= (s.charAt(i) & 0xff);
+      h *= 0x100000001b3L;
+    }
+    return h;
+  }
+}
